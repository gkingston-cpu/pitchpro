# --- Database ---
# SQLite for local dev. For production Postgres (Supabase/Neon), see README "Switching to Postgres".
DATABASE_URL="file:./dev.db"

# --- Synthesis agent (Claude API) ---
# Without this the refresh job falls back to rule-based synthesis (works, but no LLM headlines/pitches).
ANTHROPIC_API_KEY=""
# Model used for synthesis; override if needed.
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Scheduled refresh ---
# Shared secret the cron caller must send (Authorization: Bearer <CRON_SECRET>).
# Vercel Cron sets this header automatically when CRON_SECRET is defined in project env.
CRON_SECRET=""

# --- External data sources (all optional; each connector skips itself when unconfigured) ---
# NewsAPI.org — transition/M&A/growth news
NEWSAPI_KEY=""
# Adzuna job search API — competitor-tool intent + tech-modernization postings
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# --- Auth (NextAuth + Google) ---
# When GOOGLE_CLIENT_ID is empty the app runs in OPEN PREVIEW MODE (no login) — dev only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Comma-separated allow-list — the only accounts that can sign in.
ALLOWED_EMAILS="rep1@example.com,rep2@example.com"
